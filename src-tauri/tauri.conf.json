{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wayfinder",
  "version": "2.1.1",
  "identifier": "com.wayfinder.app",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Wayfinder",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxRDY3QTk5RDU3NjU1MzgKUldRNFZYYlZtWHJXSVFwdy9LL05FTDRaRTIzYlhFdEtKd0llWTB3UVByREJEY0o4OTJTdUJ4bE8K",
      "endpoints": [
        "https://cesarops.com/wayfinder/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
